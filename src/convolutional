Convulotional Neural Network for Star Tracker
% Carica il file .mat
load('data.mat');

%numero di immagini
n=length(data);
% n=90;

% Inizializza array per immagini e coordinate
img_size = size(data(1).img); % le immagini hanno la stessa dimensione
mask_size=size(data(1).mask);



X = zeros([img_size, n], 'like', data(1).img);
Y = zeros([mask_size, n], 'like', data(1).mask);  % Matrice delle coordinate


% Ciclo su tutte le immagini per estrarre i dati
for i = 1:n
    % Immagini pre-elaborate
    X(:, :,:,i) = data(i).img;

    % Coordinate delle stelle (keypoints)
    Y(:, :, i) = data(i).mask;
end



% Mescola gli indici in modo casuale
idx = randperm(n);

% Definisci le proporzioni
train_ratio = 0.7;
val_ratio = 0.2;
test_ratio = 0.1;

% Numero di dati per ciascun insieme
n_train = round(n * train_ratio);
n_val = round(n * val_ratio);
n_test = n - n_train - n_val;  % Il rimanente per il test

% Dati di training
X_train = X(:, :, :, idx(1:n_train));
Y_train = Y(:, :, idx(1:n_train));

% Dati di validazione
X_val = X(:, :, :, idx(n_train+1:n_train+n_val));
Y_val = Y(:, :, idx(n_train+1:n_train+n_val));

% Dati di test
X_test = X(:, :, :, idx(n_train+n_val+1:end));
Y_test = Y(:, :, idx(n_train+n_val+1:end));



 


% Reshape per rendere compatibili i dati di target e quelli di output
Y_train = reshape(Y_train, [128,128,1,n_train]); 
Y_val = reshape(Y_val, [128,128,1,n_val]);
Y_test = reshape(Y_test, [128,128,1,n_test]);
 
%Associazione label personalizzate
Y_train = dlarray(Y_train, 'SSCB');
Y_val = dlarray(Y_val, 'SSCB');
Y_test = dlarray(Y_test, 'SSCB');


% Definizione della rete
layers = [
    imageInputLayer([img_size(1) img_size(2) 3], 'Normalization', 'none')
    
    convolution2dLayer(3, 32, "Padding", "same")
    reluLayer

    maxPooling2dLayer(2, "Stride", 2)    
    batchNormalizationLayer

    convolution2dLayer(3, 64, "Padding", "same")
    reluLayer

    maxPooling2dLayer(2, "Stride", 2)
    batchNormalizationLayer

    convolution2dLayer(3, 128, "Padding", "same")
    reluLayer

    batchNormalizationLayer

    transposedConv2dLayer(3,32,"Stride",2,"Cropping","same")

    transposedConv2dLayer(3,32,"Stride",2,"Cropping","same")

    convolution2dLayer(1,1)
    
        
];

% Opzioni di addestramento
options = trainingOptions('adam', ...
    'InitialLearnRate',3e-4, ...
    'MaxEpochs',50, ...
    'MiniBatchSize',64,...
    'Plots','training-progress',...
    'ValidationData', {X_val, Y_val}, ...
    'ValidationFrequency',10,...
     'L2Regularization',0.005,...
    'InputDataFormats','SSCB',...
    'TargetDataFormats','SSCB');



[trainedNet,info] = trainnet(X_train,Y_train, layers,'mse' ,options);



info.TrainingHistory
info.ValidationHistory




% Predizioni
Y_pred = minibatchpredict(trainedNet, X_test);
Y_pred=double(Y_pred);
% Errore quadratico medio (MSE) per il set di validazione
mse_val = mean((Y_test - Y_pred).^2, 'all');

% Errore quadratico medio radice (RMSE)
rmse_val = sqrt(mse_val);

% Risultati
fprintf('Validation MSE: %.4f\n', mse_val);
fprintf('Validation RMSE: %.4f\n', rmse_val);
figure
imshow(Y_pred(:,:,:,9))
imshow(X_test(:,:,:,9))






